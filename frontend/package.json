{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/lab-start.mjs",
    "build": "next build",
    "start": "node scripts/lab-start.mjs --prod",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:api": "node tests/api-auth.mjs",
    "test:i18n": "node --test tests/i18n.test.mjs",
    "test:passwords": "node tests/password-api.mjs",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "test:generated-api": "node tests/generated-api.mjs",
    "test:admin-cache": "node --test tests/admin-cache.test.mjs",
    "lab:init": "node scripts/lab-admin.mjs init",
    "lab:worker": "node scripts/lab-worker.mjs",
    "lab:receiver": "node scripts/lab-receiver.mjs",
    "test:lab": "node --test tests/lab/*.test.mjs",
    "lab:start": "node scripts/lab-start.mjs",
    "test:browser": "node tests/lab/browser.mjs",
    "test:acceptance": "node tests/lab/acceptance.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tanstack/react-query": "^5.104.4",
    "i18next": "^26.5.2",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.1.0",
    "saxes": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    },
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    }
  }
}
